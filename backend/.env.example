# Copy this file to .env and fill in real values.

# Postgres connection
DATABASE_URL=postgres://attendance:attendance@localhost:5432/attendance

# Public base URL used to build the approval link sent over WhatsApp.
# e.g. https://attendance.yourdomain.com  or  http://<your-public-ip>:3000  (ngrok also works)
PUBLIC_BASE_URL=http://localhost:3000

# Port the Express server listens on
PORT=3000

# Max allowed distance (meters) override if you want a global default
# (per-site radius in the DB takes priority if set)
DEFAULT_GEOFENCE_RADIUS_METERS=150
